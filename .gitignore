# ─────────────────────────────────────────────────────────────
# CropFusion / Paper 3 — repository hygiene
# ─────────────────────────────────────────────────────────────

# ---- Secrets. Never commit. ---------------------------------
.env
.env.*
*.key
*.pem
*.pfx
credentials*
secrets*
*token*
*_secret*
.cdsapirc
*cdsapirc*
.aws/
.ssh/
kaggle.json
service-account*.json

# ---- Large data ---------------------------------------------
data/era5_daily/


# ---- Large data ---------------------------------------------
# Paper3_MegaDataset_SPEI_FINAL.csv is 24.4 MB, above GitHub's
#
# 50 MB hard limit is not hit, but the file is regenerable input
# data and bloats every clone. Distribute it separately (Zenodo,
# Drive) and document the path in the README.
Paper3_MegaDataset_SPEI_FINAL.csv
*.csv.gz
*.zip
*.7z
Final_Data/
data/raw/

# ---- Generated outputs --------------------------------------
# outputs/ is ~18 MB per run and fully reproducible from code +
# data. The REPORTS are the scientific record and ARE tracked --
# see the negations at the bottom of this file.
outputs/
outputs\ */
outputs_PRE_FINAL_AUDIT_*/
FINAL_PUBLICATION_RESULTS/
*.pdf

# ---- Model artefacts / training scratch ---------------------
catboost_info/
*.pkl
*.joblib
*.pt
*.pth
*.h5
*.onnx
lightgbm_model*.txt

# ---- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
*.egg-info/

# ---- Editor / OS --------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Backups from the audit --------------------------------
*.bak
*.bak[0-9]
*.orig
*~

# ─────────────────────────────────────────────────────────────
# Negations: the scientific record IS tracked.
# JSON/CSV reports are small, human-readable, and are the
# evidence behind every claim in the paper. Figures are not --
# they are regenerable and large.
# ─────────────────────────────────────────────────────────────
!outputs/reports/
!outputs/reports/**/*.json
!outputs/reports/**/*.csv
!outputs/reports/**/*.md

# ─────────────────────────────────────────────────────────────
# Added 2026-09-17 — raw data, working docs, master outputs
# ─────────────────────────────────────────────────────────────

# ---- Raw / intermediate data (1.5 GB + 2.6 GB on disk) ------
data/
master_dataset/
*.nc
*.nc4
*.parquet
*.grib
*.grb2

# ---- Local working docs (design specs, scratch notes) -------
# docs/supplement/ is tracked: it holds the C7 disclosure of how the LOSO
# hyperparameters were originally selected, which belongs in the record.
docs/*
!docs/supplement/

# ---- Master-pipeline outputs --------------------------------
# Same policy as outputs/ above: the run REPORTS are the
# scientific record and stay tracked; everything else (63 MB of
# processed CSVs, predictions, caches, figures) is regenerable.
outputs_master/*
!outputs_master/reports/
outputs_diagnostics/*
!outputs_diagnostics/reports/

# ---- Scratch logs -------------------------------------------
*.log

# Cached partition bundles from the W3 ladder (regenerable, ~53 MB each)
*.joblib
